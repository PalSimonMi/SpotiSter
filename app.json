{
  "expo": {
    "name": "SpotiSter",
    "slug": "SpotiSter",
    "scheme": "spotister",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SpotiSter",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SpotiSter to scan Spotify QR codes",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c18a4d63-383a-4ae1-a982-d4db34bc5d21"
      }
    }
  }
}
